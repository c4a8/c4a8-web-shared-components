{
  "name": "shared-components",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook-full": "npm run build && storybook build",
    "module:after-build": "node scripts/prepare-styles.js",
    "module:build": "node scripts/copy-components.js && node scripts/inject-scss-tools.js && nuxt-module-build build && npm run module:after-build",
    "update": "npm run module:build && node scripts/move-module.js",
    "new-version": "cd .. && npm version minor --no-git-tag-version",
    "patch": "cd .. && npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/scripts": "^1.3.10",
    "@nuxtjs/sitemap": "^8.6.1",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^0.11.3",
    "@types/jquery": "^3.5.32",
    "autoprefixer": "^10.4.21",
    "bootstrap": "^4.5.3",
    "cssnano": "^7.1.2",
    "gsap": "^3.13.0",
    "ion-rangeslider": "^2.3.1",
    "jquery": "^3.7.1",
    "lottie-web": "^5.13.0",
    "node-html-parser": "^6.1.13",
    "nuxt": "^4.5.2",
    "nuxt-i18n-micro": "^3.30.0",
    "nuxt-schema-org": "^6.4.3",
    "nuxt-seo-utils": "^8.6.1",
    "pinia": "^3.0.4",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-url": "^10.1.3",
    "sitemap": "^8.0.0",
    "slick-carousel": "^1.8.1",
    "swiper": "^12.1.2",
    "vue": "^3.5.43",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxtjs/storybook": "npm:@nuxtjs/storybook@9.1.0-29411911.f34c865",
    "@storybook/addon-docs": "10.0.8",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "better-sqlite3": "^12.5.0",
    "leaflet": "^1.9.4",
    "sass": "^1.89.2",
    "sass-embedded": "^1.89.2",
    "storybook": "10.0.8",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5"
  },
  "overrides": {
    "swiper": "^12.1.2"
  }
}
